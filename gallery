<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Interactive Photo Gallery</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      text-align: center;
      background-color: #f5f5f5;
    }

    h1 {
      margin: 20px 0;
    }

    /* Main preview area */
    #image {
      width: 500px;
      height: 350px;
      margin: 20px auto;
      background-color: #ddd;
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
      color: #555;
      border: 2px solid #aaa;
    }

    /* Thumbnail row */
    .gallery {
      display: flex;
      justify-content: center;
      gap: 15px;
      flex-wrap: wrap;
      padding: 20px;
    }

    .gallery img {
      width: 150px;
      height: 100px;
      object-fit: cover;
      cursor: pointer;
      border: 3px solid transparent;
      transition: border 0.2s;
    }

    .gallery img:hover {
      border: 3px solid #1a73e8;
    }
  </style>
</head>
<body>

  <h1>Interactive Photo Gallery</h1>

  <!-- Preview area — id="image" is required by the assignment -->
  <div id="image">Hover over an image below to display here.</div>

  <!-- Thumbnail images — each needs an alt and a src -->
  <div class="gallery">
    <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/3/3f/Bikeino.jpg/320px-Bikeino.jpg"
         alt="Cycling in the park"
         class="preview"
         onmouseover="upDate(this)"
         onmouseout="unDo()">

    <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/1/1a/24701-nature-natural-beauty.jpg/320px-24701-nature-natural-beauty.jpg"
         alt="Beautiful nature scenery"
         class="preview"
         onmouseover="upDate(this)"
         onmouseout="unDo()">

    <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/4/47/PNG_transparency_demonstration_1.png/280px-PNG_transparency_demonstration_1.png"
         alt="Colorful abstract shapes"
         class="preview"
         onmouseover="upDate(this)"
         onmouseout="unDo()">
  </div>

  <script>
    /* ─── upDate ────────────────────────────────────────────────────────────
       Called when the mouse moves OVER a thumbnail image.
       previewPic = the <img> element the mouse is hovering over.
    ─────────────────────────────────────────────────────────────────────── */
    function upDate(previewPic) {

      // Step 3a — confirm the event is firing
      console.log("upDate triggered");

      // Step 3b — log the alt text and src of the hovered image
      console.log("alt:", previewPic.alt);
      console.log("src:", previewPic.src);

      // Step 3c — update the TEXT inside the #image div to the alt text
      document.getElementById("image").textContent = previewPic.alt;

      // Step 3e — update the BACKGROUND IMAGE of the #image div
      document.getElementById("image").style.backgroundImage =
        "url('" + previewPic.src + "')";
    }


    /* ─── unDo ──────────────────────────────────────────────────────────────
       Called when the mouse LEAVES a thumbnail image.
       Resets the preview area back to its original state.
    ─────────────────────────────────────────────────────────────────────── */
    function unDo() {

      // Step 4a — clear the background image
      document.getElementById("image").style.backgroundImage = "url('')";

      // Step 4b — restore the original placeholder text
      document.getElementById("image").textContent =
        "Hover over an image below to display here.";
    }
  </script>

</body>
</html>
